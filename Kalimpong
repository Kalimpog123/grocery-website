<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>QuickCart — Online Grocery</title>
  <style>
    /* Basic reset */
    *{box-sizing:border-box;margin:0;padding:0}
    html,body{height:100%;font-family:Inter, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial;color:#0f172a;background:#f8fafc}

    /* Layout */
    .container{max-width:1200px;margin:28px auto;padding:16px}
    header{display:flex;align-items:center;gap:16px}
    .logo{font-weight:800;font-size:20px;color:#0ea5a4}
    .search{flex:1;display:flex}
    .search input{flex:1;padding:12px 14px;border-radius:10px;border:1px solid #e6eef2;background:white}
    .search button{margin-left:8px;padding:10px 14px;border-radius:10px;border:0;background:#0ea5a4;color:white;font-weight:600}

    /* Main grid */
    .main{display:grid;grid-template-columns:1fr 360px;gap:20px;margin-top:18px}
    .left{background:linear-gradient(180deg,#ffffff,#fbfdff);padding:18px;border-radius:12px;box-shadow:0 6px 20px rgba(2,6,23,0.06)}
    .right{padding:18px;border-radius:12px;background:white;min-height:200px;box-shadow:0 6px 20px rgba(2,6,23,0.06)}

    /* Filters */
    .filters{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:14px}
    .chip{padding:8px 12px;border-radius:999px;background:#eef6f6;border:1px solid #e1f0ef;font-weight:600;color:#0a6b68;cursor:pointer}
    .chip.active{background:#0ea5a4;color:white}

    /* Product grid */
    .products{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px}
    .card{background:white;padding:12px;border-radius:12px;border:1px solid #eef3f4;display:flex;flex-direction:column;gap:8px}
    .card img{width:100%;height:120px;object-fit:contain}
    .card h4{font-size:15px;margin-top:6px}
    .price{font-weight:700;color:#0ea5a4}
    .card .meta{display:flex;justify-content:space-between;align-items:center}
    .btn{padding:8px 12px;border-radius:8px;border:0;background:#0ea5a4;color:white;font-weight:700;cursor:pointer}
    .btn.ghost{background:transparent;border:1px solid #0ea5a4;color:#0ea5a4}

    /* Cart */
    .cart-empty{color:#64748b;text-align:center;padding:40px 10px}
    .cart-item{display:flex;gap:10px;align-items:center;padding:8px 0;border-bottom:1px dashed #f1f5f9}
    .cart-item img{width:56px;height:56px;object-fit:contain}
    .cart-item .title{font-weight:700}
    .qty-control{display:flex;gap:6px;align-items:center}
    .qty-control button{padding:6px 8px;border-radius:8px;border:1px solid #e6eef2;background:white;cursor:pointer}
    .totals{display:flex;justify-content:space-between;padding-top:12px;font-weight:700}

    /* Responsive */
    @media (max-width:940px){.main{grid-template-columns:1fr}.right{order:2}.left{order:1}.container{padding:12px}}

    /* Small utilities */
    .badge{background:#f8fafc;padding:6px 10px;border-radius:999px;border:1px solid #e6eef2}
    .search-suggest{position:relative}
    .suggest-list{position:absolute;left:0;right:0;background:white;border-radius:8px;margin-top:8px;padding:8px;border:1px solid #e6eef2;z-index:10}
    .suggest-list div{padding:8px;border-radius:8px;cursor:pointer}
    .suggest-list div:hover{background:#f1f5f9}

    footer{margin-top:26px;text-align:center;color:#64748b}
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="logo">QuickCart</div>
      <div class="search">
        <div style="position:relative;flex:1">
          <input id="searchInput" placeholder="Search for fruits, veggies, dairy..." aria-label="Search products" />
          <div id="suggest" class="suggest-list" style="display:none"></div>
        </div>
        <button id="searchBtn">Search</button>
        <div style="width:12px"></div>
        <div class="badge" id="cartCount">Cart: 0</div>
      </div>
    </header>

    <div class="main">
      <div class="left">
        <div class="filters">
          <div class="chip active" data-cat="all">All</div>
          <div class="chip" data-cat="fruits">Fruits</div>
          <div class="chip" data-cat="veggies">Veggies</div>
          <div class="chip" data-cat="dairy">Dairy</div>
          <div class="chip" data-cat="bakery">Bakery</div>
          <div class="chip" data-cat="beverages">Beverages</div>
        </div>

        <div class="products" id="products"></div>
      </div>

      <aside class="right">
        <h3>Your Cart</h3>
        <div id="cartList"></div>
        <div class="totals" id="totals" style="display:none">
          <div>Subtotal</div>
          <div id="subtotal">₹0</div>
        </div>
        <div style="margin-top:12px;display:flex;gap:8px">
          <button id="checkoutBtn" class="btn" style="flex:1">Checkout</button>
          <button id="clearBtn" class="btn ghost">Clear</button>
        </div>
      </aside>
    </div>

    <footer>Built with ❤️ — sample Zepto-style frontend demo</footer>
  </div>

  <!-- Sample data + JS -->
  <script>
    // Sample product catalog (would come from API in real app)
    const PRODUCTS = [
      {id:1,name:'Bananas (1 dozen)',price:59,cat:'fruits',img:'https://images.unsplash.com/photo-1574226516831-e1dff420e12b?auto=format&fit=crop&w=400&q=60'},
      {id:2,name:'Red Apples (1 kg)',price:149,cat:'fruits',img:'https://images.unsplash.com/photo-1567306226416-28f0efdc88ce?auto=format&fit=crop&w=400&q=60'},
      {id:3,name:'Tomato (1 kg)',price:39,cat:'veggies',img:'https://images.unsplash.com/photo-1572448862529-6ec1b9fb0d1b?auto=format&fit=crop&w=400&q=60'},
      {id:4,name:'Spinach (bunch)',price:24,cat:'veggies',img:'https://images.unsplash.com/photo-1524594154909-6980a2310b6b?auto=format&fit=crop&w=400&q=60'},
      {id:5,name:'Milk (1 L)',price:55,cat:'dairy',img:'https://images.unsplash.com/photo-1582719478250-715f8071f9a5?auto=format&fit=crop&w=400&q=60'},
      {id:6,name:'Paneer (250g)',price:129,cat:'dairy',img:'https://images.unsplash.com/photo-1604908177012-d1f7b4b7e7f9?auto=format&fit=crop&w=400&q=60'},
      {id:7,name:'Whole Wheat Bread',price:39,cat:'bakery',img:'https://images.unsplash.com/photo-1604908177522-4b5f4b4c3b2a?auto=format&fit=crop&w=400&q=60'},
      {id:8,name:'Mineral Water (1.5 L)',price:20,cat:'beverages',img:'https://images.unsplash.com/photo-1526392060635-9d6019884377?auto=format&fit=crop&w=400&q=60'}
    ];

    // Simple state
    let state = {products:PRODUCTS,cart:{}};

    // Utilities
    const $ = id => document.getElementById(id);
    const fmt = v => '₹' + Number(v).toFixed(0);

    // Render products
    function renderProducts(filter='all',query=''){
      const out = document.getElementById('products');
      out.innerHTML = '';
      const list = state.products.filter(p=> (filter==='all' || p.cat===filter) && (p.name.toLowerCase().includes(query.toLowerCase())) );
      if(list.length===0){ out.innerHTML = '<div style="padding:30px;color:#64748b">No items found</div>'; return }
      for(const p of list){
        const card = document.createElement('div'); card.className='card';
        card.innerHTML = `
          <img src="${p.img}" alt="${p.name}" />
          <h4>${p.name}</h4>
          <div class="meta">
            <div class="price">${fmt(p.price)}</div>
            <div><button class="btn" data-id="${p.id}">Add</button></div>
          </div>
        `;
        out.appendChild(card);
      }
    }

    // Cart management
    function setCartCount(){
      const count = Object.values(state.cart).reduce((s,i)=>s+i.qty,0);
      $('cartCount').textContent = 'Cart: ' + count;
      $('cartCount').setAttribute('data-count',count);
    }

    function renderCart(){
      const list = $('cartList'); list.innerHTML='';
      const items = Object.values(state.cart);
      if(items.length===0){ list.innerHTML = '<div class="cart-empty">Your cart is empty. Add items to get started.</div>'; $('totals').style.display='none'; return }
      let subtotal=0;
      for(const it of items){
        subtotal += it.qty * it.price;
        const div = document.createElement('div'); div.className='cart-item';
        div.innerHTML = `
          <img src="${it.img}" alt="${it.name}"/>
          <div style="flex:1">
            <div class="title">${it.name}</div>
            <div style="display:flex;justify-content:space-between;margin-top:6px;align-items:center">
              <div>${fmt(it.price)}</div>
              <div class="qty-control">
                <button class="dec" data-id="${it.id}">-</button>
                <div>${it.qty}</div>
                <button class="inc" data-id="${it.id}">+</button>
              </div>
            </div>
          </div>
        `;
        list.appendChild(div);
      }
      $('subtotal').textContent = fmt(subtotal);
      $('totals').style.display = 'flex';
    }

    function addToCart(id){
      const p = state.products.find(x=>x.id===+id); if(!p) return;
      if(state.cart[id]) state.cart[id].qty += 1; else state.cart[id] = {...p, qty:1};
      persistCart(); setCartCount(); renderCart();
    }
    function changeQty(id,delta){
      if(!state.cart[id]) return; state.cart[id].qty += delta; if(state.cart[id].qty<=0) delete state.cart[id]; persistCart(); setCartCount(); renderCart();
    }
    function clearCart(){ state.cart = {}; persistCart(); setCartCount(); renderCart(); }

    // Persistence (localStorage)
    function persistCart(){ localStorage.setItem('quickcart_cart', JSON.stringify(state.cart)); }
    function loadCart(){ const raw = localStorage.getItem('quickcart_cart'); if(raw) state.cart = JSON.parse(raw); }

    // Events
    document.addEventListener('click', e=>{
      if(e.target.matches('.btn[data-id]')) addToCart(e.target.dataset.id);
      if(e.target.matches('.inc')) changeQty(e.target.dataset.id,1);
      if(e.target.matches('.dec')) changeQty(e.target.dataset.id,-1);
      if(e.target.id==='clearBtn') clearCart();
      if(e.target.id==='checkoutBtn') alert('Checkout — demo only (implement payment & address flow)');
    });

    // Filter chips
    document.querySelectorAll('.chip').forEach(ch=>{
      ch.addEventListener('click', ()=>{
        document.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));
        ch.classList.add('active'); renderProducts(ch.dataset.cat, $('searchInput').value);
      })
    });

    // Search
    $('searchBtn').addEventListener('click', ()=>{ const q = $('searchInput').value; const active = document.querySelector('.chip.active').dataset.cat; renderProducts(active,q); });
    $('searchInput').addEventListener('input', e=>{
      // rudimentary suggestions from product names
      const q = e.target.value.trim().toLowerCase(); const sug = $('suggest');
      if(!q){ sug.style.display='none'; return }
      const hits = PRODUCTS.filter(p=>p.name.toLowerCase().includes(q)).slice(0,6);
      sug.innerHTML = hits.map(h=>`<div data-id="${h.id}">${h.name}</div>`).join(''); sug.style.display = hits.length? 'block':'none';
    });
    $('suggest').addEventListener('click', e=>{ if(e.target.dataset.id){ const p = PRODUCTS.find(x=>x.id==e.target.dataset.id); if(p){ $('searchInput').value = p.name; $('suggest').style.display='none'; renderProducts(document.querySelector('.chip.active').dataset.cat, p.name); } } });

    // Init
    (function init(){ loadCart(); setCartCount(); renderProducts(); renderCart(); })();
  </script>
</body>
</html>
